FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv/backend

COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/app ./app

RUN addgroup --system nexus && adduser --system --ingroup nexus nexus \
    && mkdir -p /srv/highlight-media /srv/highlight-work \
    && chown -R nexus:nexus /srv/highlight-media /srv/highlight-work

USER nexus

CMD ["python", "-m", "app.modules.highlight_generator.media_worker"]
