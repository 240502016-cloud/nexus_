# Bu dosya yalnizca izole yerel insan testi icindir.
COMPOSE_PROJECT_NAME=nexus-local

POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=local-admin-secret-placeholder
POSTGRES_USER=nexus_local
POSTGRES_PASSWORD=local-app-secret-placeholder
POSTGRES_DB=nexus_local
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
SYNAPSE_POSTGRES_USER=synapse_local
SYNAPSE_POSTGRES_PASSWORD=local-synapse-db-secret-placeholder
SYNAPSE_POSTGRES_DB=synapse_local
CORE_API_SECRET_KEY=local-core-secret-placeholder

NEXUS_DOMAIN=localhost
NEXUS_ACME_EMAIL=local@example.test
NEXUS_HTTP_PORT=18080
NEXUS_HTTPS_PORT=18443
NEXUS_PUBLIC_URL=http://localhost:5173
NEXUS_MATRIX_SERVER_AUTHORITY=localhost:5173
CLOUDFLARE_API_TOKEN=local-unused

MATRIX_SERVER_NAME=localhost
MATRIX_HOMESERVER_URL=http://matrix:8008
MATRIX_REGISTRATION_SHARED_SECRET=local-matrix-registration-secret-placeholder
MATRIX_MACAROON_SECRET_KEY=local-matrix-macaroon-secret-placeholder
MATRIX_FORM_SECRET=local-matrix-form-secret-placeholder

# Docker icindeki yerel Gateway, host makinedeki Ollama'ya buradan gider.
LOCAL_OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_GATEWAY_API_KEY=local-ai-gateway-secret-placeholder
AI_GATEWAY_ALLOWED_NETWORKS=0.0.0.0/0,::/0
AI_GATEWAY_TRUSTED_PROXIES=
AI_GATEWAY_MAX_REQUEST_BYTES=1048576
OLLAMA_BASE_URL=http://ai-gateway:8090
OLLAMA_API_KEY=local-ai-gateway-secret-placeholder
OLLAMA_DEFAULT_MODEL=qwen2.5:7b
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_READ_TIMEOUT_SECONDS=120
# Modeli bellekte tutar; soğuk yükleme modül timeout'larını aşıyor.
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_RETRIES=2
OLLAMA_RETRY_BACKOFF_SECONDS=0.5
OLLAMA_MODEL_CACHE_SECONDS=30

AI_WORKER_POLL_SECONDS=0.5
AI_WORKER_LEASE_SECONDS=300
AI_WORKER_MAX_ATTEMPTS=3
AI_WORKER_RETRY_BACKOFF_SECONDS=2.0
AI_MAX_PENDING_JOBS_PER_USER=20
AI_CONTEXT_TOKEN_BUDGET=3072
AI_MAX_OUTPUT_TOKENS=1024
AI_STREAM_POLL_SECONDS=0.15
# Ölçülen hızlar: qwen2.5:7b 27,8 token/sn · gpt-oss:20b 17,7 token/sn.
# Ollama'yı OLLAMA_KEEP_ALIVE=-1 ile çalıştır; yoksa soğuk yükleme (7b 8,1 sn /
# 20b 23,2 sn) bu timeout'ların hepsini aşar.
COMMENTATOR_LIVE_MODEL=qwen2.5:7b
COMMENTATOR_TIMEOUT_SECONDS=5
COMMENTATOR_STALE_SECONDS=6
MEME_TEXT_MODEL=gpt-oss:20b
MEME_TIMEOUT_SECONDS=25
HIGHLIGHT_METADATA_MODEL=qwen2.5:7b
HIGHLIGHT_METADATA_TIMEOUT_SECONDS=10
ROAST_GENERATE_MODEL=gpt-oss:20b
ROAST_REVIEW_MODEL=gpt-oss:20b
ROAST_GENERATE_TIMEOUT_SECONDS=20
ROAST_REVIEW_TIMEOUT_SECONDS=10
BOARD_GAME_NARRATOR_MODEL=gpt-oss:20b
BOARD_GAME_NARRATOR_TIMEOUT_SECONDS=12
HIDDEN_ROLE_RECAP_MODEL=gpt-oss:20b
HIDDEN_ROLE_RECAP_TIMEOUT_SECONDS=20
SHARED_STORY_MODEL=gpt-oss:20b
SHARED_STORY_TIMEOUT_SECONDS=45
ESCAPE_ROOM_HOST_MODEL=gpt-oss:20b
ESCAPE_ROOM_HOST_TIMEOUT_SECONDS=15

GENERATED_MEDIA_DIR=/srv/generated-media
HIGHLIGHT_MEDIA_DIR=/srv/highlight-media
HIGHLIGHT_MAX_UPLOAD_BYTES=1073741824
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
HIGHLIGHT_PROBE_TIMEOUT_SECONDS=30
HIGHLIGHT_RENDER_TIMEOUT_SECONDS=600
MEDIA_WORKER_POLL_SECONDS=0.5

PLUGIN_EXECUTION_MODE=sandbox
PLUGIN_SANDBOX_URL=http://plugin-sandbox:8091
PLUGIN_SANDBOX_API_KEY=local-plugin-secret-placeholder
PLUGIN_SANDBOX_TIMEOUT_SECONDS=10
PLUGIN_SANDBOX_MAX_PAYLOAD_BYTES=65536
PLUGIN_SANDBOX_MAX_OUTPUT_BYTES=65536

# Yerel testte TURN ve dis reverse proxy baslatilmaz; degerler Compose dogrulamasi icindir.
TURN_DOMAIN=localhost
TURN_PORT=3478
TURN_MIN_PORT=50000
TURN_MAX_PORT=50040
TURN_EXTERNAL_IP=127.0.0.1
TURN_AUTH_SECRET=local-turn-secret-placeholder
TURN_CREDENTIAL_TTL_SECONDS=3600
